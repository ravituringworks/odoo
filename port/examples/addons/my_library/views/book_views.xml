<odoo>
  <record id="library_book_form" model="ir.ui.view"><field name="name">library.book.form</field><field name="model">library.book</field>
    <field name="arch" type="xml"><form><header><button name="action_lend" type="object" string="Lend"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="isbn"/><field name="author_id"/><field name="pages"/></group></sheet></form></field></record>
  <record id="library_book_action" model="ir.actions.act_window"><field name="name">Books</field><field name="res_model">library.book</field><field name="view_mode">list,form</field></record>
  <menuitem id="library_menu_root" name="Library"/><menuitem id="library_menu_books" name="Books" parent="library_menu_root" action="library_book_action"/>
</odoo>
