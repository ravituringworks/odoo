<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_prep_display_view_form" model="ir.ui.view">
        <field name="name">pos_preparation_display.display.form</field>
        <field name="model">pos_preparation_display.display</field>
        <field name="arch" type="xml">
            <form string="Preparation Display">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="pos_config_ids" widget="many2many_tags"/>
                        <field name="category_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pos_prep_display_action" model="ir.actions.act_window">
        <field name="name">Preparation Displays</field>
        <field name="res_model">pos_preparation_display.display</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_pos_prep_display" name="Preparation Displays" parent="point_of_sale.menu_point_config_product" action="pos_prep_display_action" sequence="30"/>
</odoo>
