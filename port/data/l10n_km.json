    "name": "Credit balance from previous return",
    "code": "KM_CREDIT_REPORTED",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_km_credit_reported_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "KM_CREDIT_REPORTED._applied_carryover_tax"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_km_credit_reported_tax_carryover",
   "values": {
    "label": "_applied_carryover_tax",
    "engine": "external",
    "formula": "most_recent",
    "date_scope": "previous_tax_period"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_km_due",
   "values": {
    "name": "Due tax for the month",
    "code": "KM_DUE",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_km_due_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "KM_OPERATIONS.tax - KM_PREPAYMENTS.tax - KM_CREDIT_REPORTED.tax",
    "subformula": "if_above(KMF(0))"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_km_credit_to_report",
   "values": {
    "name": "Credit balance to report for the next return",
    "code": "KM_TO_REPORT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_km_credit_to_report_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "KM_PREPAYMENTS.tax + KM_CREDIT_REPORTED.tax - KM_OPERATIONS.tax",
    "subformula": "if_above(KMF(0))",
    "carryover_target": false
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_km_credit_to_report_carryover",
   "values": {
    "label": "_carryover_tax",
    "engine": "aggregation",
    "formula": "KM_TO_REPORT.tax",
    "carryover_target": "KM_CREDIT_REPORTED._applied_carryover_tax"
   }
  },
