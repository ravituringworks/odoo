    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_sales_export_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "export"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_sales_exempt",
   "values": {
    "name": "Exempt",
    "code": "ML_SALE_EXEMPT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_sales_exempt_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "sale_exempt"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_refund_regularisation",
   "values": {
