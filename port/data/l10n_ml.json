    "code": "ML_REFUND_REGU",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_refund_regularisation_tax",
   "values": {
    "label": "tax",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_gross_pay",
   "values": {
    "name": "Gross VAT to pay",
    "code": "ML_GROSS_PAY",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_gross_pay_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "ML_REFUND_REGU.tax + ML_SALES.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_deductible",
   "values": {
    "name": "Deductible",
    "code": "ML_DEDUCTIBLE",
    "expression_ids": {
     "$unevaluated": "xml"
    },
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_deductible_base",
   "values": {
    "label": "base",
    "engine": "aggregation",
    "formula": "ML_PURC_TAXABLE.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_deductible_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "ML_PURC_TAXABLE.tax + ML_WITHHELD.tax + ML_DEDU_ADJUSTMENT.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_purchases_taxable",
   "values": {
    "name": "Taxable",
    "code": "ML_PURC_TAXABLE",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_purchases_taxable_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "purc_base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_purchases_taxable_tax",
   "values": {
    "label": "tax",
    "engine": "tax_tags",
    "formula": "purc_tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_purchases_withheld",
   "values": {
    "name": "VAT withheld by clients",
    "code": "ML_WITHHELD",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_purchases_withheld_tax",
   "values": {
    "label": "tax",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_purchases_deduction_adjustment",
   "values": {
    "name": "Additional deduction following adjustment",
    "code": "ML_DEDU_ADJUSTMENT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_purchases_deduction_adjustment_tax",
   "values": {
    "label": "tax",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_purchases_credit_reported",
   "values": {
    "name": "Credit to be carried forward from previous months",
    "code": "ML_CREDIT_REPORTED",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_purchases_credit_reported_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "ML_CREDIT_REPORTED._applied_carryover_tax"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_purchases_credit_reported_tax_carryover",
   "values": {
    "label": "_applied_carryover_tax",
    "engine": "external",
    "formula": "most_recent",
    "date_scope": "previous_tax_period"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_deductions",
   "values": {
    "name": "Total deductions",
    "code": "ML_DEDUCTIONS",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_deductions_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "ML_DEDUCTIBLE.tax + ML_CREDIT_REPORTED.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_to_pay",
   "values": {
    "name": "Net VAT to pay",
    "code": "ML_TO_PAY",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_to_pay_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "ML_SALES.tax - ML_DEDUCTIONS.tax",
    "subformula": "if_above(XOF(0))"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_credit_report",
   "values": {
    "name": "VAT credit to report",
    "code": "ML_CREDIT_REPORT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_credit_report_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "ML_DEDUCTIONS.tax - ML_SALES.tax",
    "subformula": "if_above(XOF(0))"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_reimbursement",
   "values": {
    "name": "Reimbursement Asked",
    "code": "ML_REIMBURSEMENT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_reimbursement_tax",
   "values": {
    "label": "tax",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ml_credit_report_deductions",
   "values": {
    "name": "Credit to report coming from deductions",
    "code": "ML_CREDIT_REPROT_DEDU",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_credit_report_deductions_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "ML_CREDIT_REPORT.tax - ML_REIMBURSEMENT.tax",
    "subformula": "if_above(XOF(0))",
    "carryover_target": false
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ml_credit_report_deductions_carryover",
   "values": {
    "label": "_carryover_tax",
    "engine": "aggregation",
    "formula": "ML_CREDIT_REPROT_DEDU.tax",
    "carryover_target": "ML_CREDIT_REPORTED._applied_carryover_tax"
   }
  },
