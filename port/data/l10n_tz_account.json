{
 "module": "l10n_tz_account",
 "records": [
  {
   "model": "account.report",
   "id": "tax_report",
   "values": {
    "name": "Tax Report",
    "root_report_id": {
     "$ref": "account.generic_tax_report"
    },
    "country_id": {
     "$ref": "base.tz"
    },
    "filter_fiscal_position": true,
    "availability_condition": "country",
    "column_ids": {
     "$unevaluated": "xml"
    },
    "line_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.column",
   "id": "tax_report_value",
   "values": {
    "name": "Value (Excluding VAT)",
    "expression_label": "value"
   }
  },
  {
   "model": "account.report.column",
   "id": "tax_report_rate",
   "values": {
    "name": "VAT Rate",
    "expression_label": "rate"
   }
  },
  {
   "model": "account.report.column",
   "id": "tax_report_amount",
   "values": {
    "name": "VAT Amount",
    "expression_label": "amount"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_goods_or_services",
   "values": {
    "name": "Supplies of goods & or Services",
    "code": "tz_goods_or_services",
    "hierarchy_level": "0",
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_taxable_supplies",
   "values": {
    "name": "Taxable supplies",
    "code": "taxable_supplies",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_taxable_supplies_expr_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "02.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_taxable_supplies_expr_rate",
   "values": {
    "label": "rate",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_taxable_supplies_expr_amount",
   "values": {
    "label": "amount",
    "engine": "tax_tags",
    "formula": "03.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_capital_good_deferred_vat",
   "values": {
    "name": "Value of capital Goods for which VAT is deferred",
    "code": "capital_good_deferred_vat",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_capital_good_deferred_vat_expr_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "05.base"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_zero_rated_supplies",
   "values": {
    "name": "Zero rated supplies",
    "code": "zero_rated_supplies",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_zero_rated_supplies_expr_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "06.base"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_exempt_supplies",
   "values": {
    "name": "Exempt supplies",
    "code": "exempt_supplies",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_exempt_supplies_expr_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "07.base"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_special_relief",
   "values": {
    "name": "Special relief / deferred supplies",
    "code": "special_relief",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_special_relief_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "08.base"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_imported_services",
   "values": {
    "name": "Value of imported services",
    "code": "imported_services",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_imported_services_expr_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "09.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_imported_services_expr_rate",
   "values": {
    "label": "rate",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_imported_services_expr_amount",
   "values": {
    "label": "amount",
    "engine": "tax_tags",
    "formula": "10.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_tz_total_output_tax",
   "values": {
    "name": "Total output (sales) and Tax",
    "code": "tz_total_output_tax",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_tz_total_output_tax_expr_value",
   "values": {
    "label": "value",
    "engine": "aggregation",
    "formula": "taxable_supplies.value\n                                    + capital_good_deferred_vat.value\n                                    + zero_rated_supplies.value\n                                    + exempt_supplies.value\n                                    + special_relief.value\n                                    + imported_services.value"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_tz_total_output_tax_expr_amount",
   "values": {
    "label": "amount",
    "engine": "aggregation",
    "formula": "taxable_supplies.amount\n                                    + imported_services.amount"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_purchase",
   "values": {
    "name": "Purchase (Inputs)",
    "code": "tz_purchase",
    "hierarchy_level": "0",
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_exempt_purchases",
   "values": {
    "name": "Exempt (local & imports) purchases",
    "code": "exempt_purchases",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_exempt_purchases_expr_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "14.base"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_non_creditable_purchases",
   "values": {
    "name": "Non-Creditable purchases",
    "code": "non_creditable_purchases",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_non_creditable_purchases_expr_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "15.base"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_capital_goods_deferred_vat_purchases",
   "values": {
    "name": "Value of capital Goods for which VAT is deferred",
    "code": "capital_goods_deferred_vat_purchases",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_capital_goods_deferred_vat_purchases_expr_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "16.base"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_imported_services_purchases",
   "values": {
    "name": "Value of imported services",
    "code": "imported_services_purchases",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_imported_services_purchases_expr_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "17.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_imported_services_purchases_expr_rate",
   "values": {
    "label": "rate",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_imported_services_purchases_expr_amount",
   "values": {
    "label": "amount",
    "engine": "tax_tags",
    "formula": "18.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_taxable_supplies_purchases",
   "values": {
    "name": "Taxable supplies",
    "code": "taxable_supplies_purchases",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_taxable_supplies_purchases_expr_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "20.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_taxable_supplies_purchases_expr_rate",
   "values": {
    "label": "rate",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_taxable_supplies_purchases_expr_amount",
   "values": {
    "label": "amount",
    "engine": "tax_tags",
    "formula": "21.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_imports_taxable_supplies_purchases",
   "values": {
    "name": "Imports of taxable supplies",
    "code": "imports_taxable_supplies_purchases",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_imports_taxable_supplies_purchases_expr_value",
   "values": {
    "label": "value",
    "engine": "tax_tags",
    "formula": "23.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_imports_taxable_supplies_purchases_expr_rate",
   "values": {
    "label": "rate",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_imports_taxable_supplies_purchases_expr_amount",
   "values": {
    "label": "amount",
    "engine": "tax_tags",
    "formula": "24.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_tz_total_input_tax",
   "values": {
    "name": "Total input tax",
    "code": "tz_total_input_tax",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_tz_total_input_tax_expr_amount",
   "values": {
    "label": "amount",
    "engine": "aggregation",
    "formula": "imported_services_purchases.amount\n                                    + taxable_supplies_purchases.amount\n                                    + imports_taxable_supplies_purchases.amount"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_total_vat_payable",
   "values": {
    "name": "Total VAT Payable/Refundable",
    "code": "total_vat_payable",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_total_vat_payable_expr_amount",
   "values": {
    "label": "amount",
    "engine": "aggregation",
    "formula": "tz_total_output_tax.amount -\n                                    tz_total_input_tax.amount"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_credit_bought_forward",
   "values": {
    "name": "VAT credit brought forward",
    "code": "tz_credit_bought_forward",
    "hierarchy_level": "0",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_credit_bought_forward_applied_carryover",
   "values": {
    "label": "_applied_carryover_amount",
    "engine": "external",
    "formula": "most_recent",
    "date_scope": "previous_tax_period"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_credit_bought_forward_expr_amount",
   "values": {
    "label": "amount",
    "engine": "aggregation",
    "formula": "tz_credit_bought_forward._applied_carryover_amount"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_total_vat_due",
   "values": {
    "name": "Total VAT due or carried forward",
    "code": "tz_total_vat_due",
    "hierarchy_level": "0",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_total_vat_due_expr_amount",
   "values": {
    "label": "amount",
    "engine": "aggregation",
    "formula": "total_vat_payable.amount + tz_credit_bought_forward.amount"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tz_total_vat_due_carryover",
   "values": {
    "label": "_carryover_amount",
    "engine": "aggregation",
    "formula": "tz_total_vat_due.amount",
    "carryover_target": "tz_credit_bought_forward._applied_carryover_amount",
    "subformula": "if_below(TSH(0))"
   }
  },
  {
