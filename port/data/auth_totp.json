   "group": "base.group_user",
   "read": true,
   "write": false,
   "create": false,
   "unlink": false
  },
  {
   "id": "access_auth_totp_device_access_portal",
   "model": "auth.totp.device",
   "model_xmlid": "model_auth_totp_device",
   "group": "base.group_portal",
   "read": true,
   "write": false,
   "create": false,
   "unlink": false
  }
 ]
