     "$ref": "website.main_menu"
    },
    "sequence": "30"
   }
  },
  {
   "model": "ir.actions.act_url",
   "id": "action_open_website",
   "values": {
    "name": "Website Home",
    "target": "self",
    "url": "/event"
   }
  },
  {
   "model": "ir.actions.todo",
