    "name": "Event published",
    "res_model": "event.event",
    "default": false,
    "description": "Event published"
   }
  },
  {
   "model": "mail.message.subtype",
   "id": "mt_event_unpublished",
   "values": {
    "name": "Event unpublished",
    "res_model": "event.event",
    "default": false,
    "description": "Event unpublished"
   }
  },
  {
   "model": "ir.filters",
   "id": "ir_filters_event_list_snippet",
   "values": {
    "name": "Upcoming Events",
    "model_id": "event.event",
    "user_id": false,
    "domain": {
     "$unevaluated": "[\n            ('date_begin', '>=', context_today()),\n            ('is_visible_on_website', '=', True)\n        ]"
    },
    "sort": "[\"date_begin asc\"]"
   }
  },
  {
   "model": "website.snippet.filter",
   "id": "website_snippet_filter_event_list",
   "values": {
    "filter_id": {
     "$ref": "website_event.ir_filters_event_list_snippet"
    },
    "field_names": "name,subtitle",
    "limit": 16,
    "name": "Upcoming Events"
   }
  },
  {
   "model": "ir.filters",
   "id": "ir_filters_event_list_snippet_unfinished",
   "values": {
    "name": "Upcoming and Ongoing Events",
    "model_id": "event.event",
    "user_id": false,
    "domain": [
     [
      "is_finished",
      "=",
      false
     ],
     [
      "is_visible_on_website",
      "=",
      true
     ]
    ],
    "sort": "[\"date_begin asc\"]"
   }
  },
  {
   "model": "website.snippet.filter",
   "id": "website_snippet_filter_event_list_unfinished",
