{
 "module": "hr_gamification",
 "records": [
  {
   "model": "ir.rule",
   "id": "goal_gamification_hr_user_visibility",
   "values": {
    "name": "HR Officer can see any goal",
    "model_id": {
     "$ref": "gamification.model_gamification_goal"
    },
    "groups": [
     [
      4,
      {
       "$ref": "hr.group_hr_user"
      }
     ]
    ],
    "perm_read": true,
    "perm_write": true,
    "perm_create": false,
    "perm_unlink": false
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "action_reward_wizard",
   "values": {
    "name": "Reward Employee",
    "res_model": "gamification.badge.user.wizard",
    "view_mode": "form",
    "view_id": {
     "$ref": "view_badge_wizard_reward"
    },
    "target": "new",
    "domain": [],
    "context": {
     "$unevaluated": "{'default_employee_id': active_id, 'employee_id': active_id}"
    }
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "goals_menu_groupby_action2",
   "values": {
    "res_model": "gamification.goal",
    "name": "Goals History",
    "view_mode": "list,kanban",
    "context": {
     "search_default_group_by_user": true,
     "search_default_group_by_definition": true
    },
    "domain": [
     [
      "challenge_id.challenge_category",
      "=",
      "hr"
     ]
    ],
    "help": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "challenge_list_action2",
   "values": {
    "name": "Challenges",
    "res_model": "gamification.challenge",
    "view_mode": "kanban,list,form",
    "domain": [
     [
      "challenge_category",
      "=",
      "hr"
     ]
    ],
    "context": {
     "search_default_inprogress": true,
     "default_inprogress": true
    },
    "help": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "ir.actions.act_window.view",
   "id": "challenge_list_action2_view1",
   "values": {
    "sequence": 1,
    "view_mode": "kanban",
    "act_window_id": {
     "$ref": "challenge_list_action2"
    },
    "view_id": {
     "$ref": "gamification.view_challenge_kanban"
    }
   }
  },
  {
   "model": "ir.actions.act_window.view",
   "id": "challenge_list_action2_view2",
   "values": {
    "sequence": 10,
    "view_mode": "form",
    "act_window_id": {
     "$ref": "challenge_list_action2"
    },
    "view_id": {
     "$ref": "gamification.challenge_form_view"
    }
   }
  }
 ],
