    "view_id": false,
    "search_view_id": {
     "$ref": "view_repair_order_form_filter"
    },
    "domain": {
     "$unevaluated": "[('picking_type_id', '=', active_id)]"
    },
    "context": {
     "$unevaluated": "{'default_picking_type_id': active_id}"
    }
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "action_picking_repair_graph",
