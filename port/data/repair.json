    },
    "product_uom": {
     "$ref": "uom.product_uom_unit"
    },
    "user_id": "",
    "picking_type_id": {
     "$ref": "picking_type_warehouse0_repair"
    },
    "move_ids": {
     "$unevaluated": "[(5, 0, 0), (0, 0, {             'location_dest_id': obj().env.ref('product.product_product_13').property_stock_producti"
    },
