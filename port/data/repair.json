{
 "module": "repair",
 "records": [
  {
   "model": "ir.rule",
   "id": "repair_order_rule",
   "values": {
    "name": "repair order multi-company",
    "model_id": {
     "$unevaluated": "search"
    },
    "domain_force": "[('company_id', 'in', company_ids)]"
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "action_repair_move_lines",
   "values": {
    "name": "Inventory Moves",
    "res_model": "stock.move.line",
    "view_mode": "list,form",
    "domain": {
     "$unevaluated": "[('move_id.repair_id', '=', active_id)]"
    }
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "action_repair_order_form",
   "values": {
    "name": "Repair Orders",
    "type": "ir.actions.act_window",
    "res_model": "repair.order",
    "view_mode": "form"
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "action_repair_order_tree",
   "values": {
    "name": "Repair Orders",
    "path": "repairs",
    "res_model": "repair.order",
    "view_mode": "list,kanban,graph,pivot,form,activity",
    "search_view_id": {
     "$ref": "view_repair_order_form_filter"
    },
    "help": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "action_repair_order_graph",
   "values": {
    "name": "Repair Orders",
    "context": {
     "search_default_product": 1,
     "search_default_createDate": 1
    },
    "res_model": "repair.order",
    "view_mode": "list,kanban,graph,pivot,form",
    "view_id": {
     "$ref": "view_repair_graph"
    }
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "action_picking_repair",
