   "id": "sale_action_quotations_new",
   "values": {
    "name": "Quotation",
    "res_model": "sale.order",
    "view_mode": "form,list,graph",
    "domain": {
     "$unevaluated": "[('opportunity_id', '=', active_id)]"
    },
    "context": {
     "$unevaluated": "{'search_default_opportunity_id': active_id, 'default_opportunity_id': active_id}"
    }
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "crm.crm_lead_opportunities",
   "values": {
    "context": {
     "$unevaluated": "{'default_type': 'opportunity', 'default_user_id': uid}"
    }
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "sales_team.mail_activity_type_action_config_sales",
   "values": {
    "domain": [
     "|",
     [
      "res_model",
      "=",
      false
     ],
     [
      "res_model",
      "in",
      [
       "crm.lead",
       "sale.order",
       "res.partner",
       "product.template",
       "product.product"
      ]
     ]
    ]
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "crm_quotation_partner_action",
   "values": {
    "name": "New Quotation",
    "res_model": "crm.quotation.partner",
    "view_mode": "form",
    "view_id": {
     "$ref": "crm_quotation_partner_view_form"
    },
    "target": "new"
   }
  }
 ],
 "menus": [
  {
   "id": "sale_order_menu_quotations_crm",
   "name": "My Quotations",
   "parent": "crm.crm_menu_sales",
   "action": "sale.action_quotations",
   "sequence": "2"
  }
 ],
 "access": [
  {
   "id": "access_crm_quotation_partner",
   "model": "crm.quotation.partner",
   "model_xmlid": "model_crm_quotation_partner",
   "group": "sales_team.group_sale_salesman",
   "read": true,
   "write": true,
   "create": true,
   "unlink": false
  }
 ]
}