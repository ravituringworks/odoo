    "code": "CM_ADJUSTMENT_TO_DEDUCT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_cm_adjustment_to_deduct_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "CM_ADJUSTMENT_DEDUCTIBLE.tax + CM_ADJUSTMENT_STATE.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_cm_adjustment_to_pay",
   "values": {
    "name": "31. VAT adjustment to be repaid (L26+L27)",
    "code": "CM_ADJUSTMENT_TO_PAY",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_cm_adjustment_to_pay_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "CM_ADJUSTMENT_FIXED.tax + CM_ADJUSTMENT_OTHER.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_cm_vat_to_pay",
   "values": {
    "name": "32. VAT to pay (L28-L29-L30+L31)",
    "code": "CM_VAT_TO_PAY",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_cm_vat_to_pay_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "CM_COLLECTED.tax - CM_DEDUCTIBLE_VAT_29.tax - CM_ADJUSTMENT_TO_DEDUCT.tax + CM_ADJUSTMENT_TO_PAY.tax",
    "subformula": "if_above(XAF(0))"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_cm_vat_credit",
   "values": {
    "name": "33. VAT credit",
    "code": "CM_CREDIT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_cm_vat_credit_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "CM_DEDUCTIBLE_VAT_29.tax + CM_ADJUSTMENT_TO_DEDUCT.tax - CM_COLLECTED.tax - CM_ADJUSTMENT_TO_PAY.tax",
    "subformula": "if_above(XAF(0))"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_cm_reimbursement",
   "values": {
    "name": "34. Reimbursement asked",
    "code": "CM_REIMBURSEMENT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_cm_reimbursement_tax",
   "values": {
    "label": "tax",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_cm_credit_to_report",
   "values": {
    "name": "35. Credit to report (L33-L34)",
    "code": "CM_CREDIT_REPORT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_cm_vat_credit_to_report_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "CM_CREDIT.tax - CM_REIMBURSEMENT.tax",
    "subformula": "if_above(XAF(0))",
    "carryover_target": false
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_cm_vat_credit_to_report_carryover",
   "values": {
    "label": "_carryover_tax",
    "engine": "aggregation",
    "formula": "CM_CREDIT_REPORT.tax",
    "carryover_target": "CM_CREDIT_REPORTED._applied_carryover_tax"
   }
  },
