    "label": "tax",
    "engine": "aggregation",
    "formula": "CM_CREDIT_REPORTED.tax + CM_LOCAL_PURCHASE.tax + CM_LOCAL_SERVICE.tax + CM_FOREIGN_PURCHASE.tax + CM_FOREIGN_SERVICE.tax"
   }
  },
