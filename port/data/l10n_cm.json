    "label": "base",
    "engine": "aggregation",
    "formula": "CM_NORMAL.base + CM_EXCISE.base + CM_OTHER.base + CM_EXPORT.base + CM_EXEMPT.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_cm_turnover_global_tax",
   "values": {
