    "code": "L10N_NG_B40",
    "hierarchy_level": "1",
    "aggregation_formula": "L10N_NG_B20.balance - L10N_NG_B25.balance - L10N_NG_B30.balance + L10N_NG_B35.balance"
   }
  },
  {
