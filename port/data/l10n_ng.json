    "code": "L10N_NG_C95",
    "hierarchy_level": "1",
    "aggregation_formula": "L10N_NG_C80.balance - L10N_NG_C85.balance - L10N_NG_C90.balance"
   }
  },
  {
   "model": "account.report.line",
