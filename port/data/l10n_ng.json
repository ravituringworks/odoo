  },
  {
   "model": "account.report.line",
   "id": "l10n_ng_tr_c_115",
   "values": {
    "name": "115. Unrelieved VAT Credit Carried Forward",
    "code": "L10N_NG_C115",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "l10n_ng_tr_c_115_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "L10N_NG_C105.balance - L10N_NG_C110.balance",
    "subformula": "if_below(NGN(0))"
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_c_115_carryover",
   "values": {
    "label": "_carryover_balance",
    "engine": "aggregation",
    "formula": "L10N_NG_C115.balance",
    "carryover_target": "L10N_NG_C100._applied_carryover_balance",
    "subformula": false
   }
  },
  {
   "model": "account.report.line",
   "id": "l10n_ng_tr_c_120",
   "values": {
    "name": "120. VAT Payable",
    "code": "L10N_NG_C120",
    "hierarchy_level": "1",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "l10n_ng_tr_c_120_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "L10N_NG_C95.balance + L10N_NG_C100.balance",
    "subformula": "if_above(NGN(0))"
   }
