   "model": "account.report.expression",
   "id": "l10n_ng_tr_c_100_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "L10N_NG_C100.tag + L10N_NG_C100._applied_carryover_balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "l10n_ng_tr_c_105",
