   "id": "l10n_ng_tr_c_100_balance_carryover",
   "values": {
    "label": "_applied_carryover_balance",
    "engine": "external",
    "formula": "most_recent",
    "date_scope": "previous_tax_period"
   }
  },
  {
   "model": "account.report.expression",
   "id": "l10n_ng_tr_100_tag",
