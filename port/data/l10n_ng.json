    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "l10n_ng_tr_b_85_tag",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "85"
   }
  },
  {
   "model": "account.report.line",
   "id": "l10n_ng_tr_c_90",
