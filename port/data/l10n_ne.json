    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_sales_total_turnover_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "NE_TAXABLE.balance + NE_EXPORT.balance + NE_EXEMPT.balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_gross",
   "values": {
    "name": "II. Gross VAT",
    "code": "NE_GROSS",
    "hierarchy_level": "0",
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_gross_vat",
   "values": {
    "name": "8. Gross VAT (line 4x19%)",
    "code": "NE_GROSS_VAT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_gross_vat_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "NE_8"
   }
  },
  {
