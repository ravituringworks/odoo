    "code": "NE_EXPORT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_sales_export_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "NE_5"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_sales_exempt",
   "values": {
    "name": "6. Other exempted turnover",
    "code": "NE_EXEMPT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_sales_exempt_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "NE_6"
