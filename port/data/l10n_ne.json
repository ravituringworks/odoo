    "name": "VAT Report",
    "root_report_id": {
     "$ref": "account.generic_tax_report"
    },
    "country_id": {
     "$ref": "base.ne"
    },
    "filter_fiscal_position": true,
    "availability_condition": "country",
    "column_ids": {
     "$unevaluated": "xml"
    },
    "line_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
