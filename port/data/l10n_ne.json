    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_deductible_imported_invest_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "NE_10"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_deductible_local_invest",
   "values": {
    "name": "11. VAT on local investments",
    "code": "NE_LOCAL_INVEST",
    "expression_ids": {
