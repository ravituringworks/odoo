    "code": "NE_REPORTED",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_deductible_reported_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "NE_REPORTED._applied_carryover_balance"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_deductible_reported_balance_carryover",
   "values": {
    "label": "_applied_carryover_balance",
    "engine": "external",
    "formula": "most_recent",
    "date_scope": "previous_tax_period"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_deductible_self",
   "values": {
    "name": "16. VAT on self deliveries",
    "code": "NE_VAT_SELF_DELIVERIES",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_deductible_self_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "NE_16"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_deductible_total",
   "values": {
    "name": "17. Total deductible VAT (10 to 16)",
    "code": "NE_DEDUCTIBLE_TOTAL",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_deductible_total_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "NE_IMPORT_INVEST.balance + NE_LOCAL_INVEST.balance + NE_IMPORT_GOODS_SERVICES.balance + NE_LOCAL_GOODS_SERVICES.balance + NE_WITHHELD.balance + NE_REPORTED.balance + NE_VAT_SELF_DELIVERIES.balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_net_vat",
   "values": {
    "name": "IV. Net VAT",
    "code": "NE_NET",
    "hierarchy_level": "0",
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_net_regularisation",
   "values": {
    "name": "Regularisation",
    "code": "NE_REGULARISATION",
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_net_deductible_addition",
   "values": {
    "name": "18. - Additional deductible vat",
    "code": "NE_DEDUCTIBLE_ADDITION",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_net_deductible_addition_balance",
   "values": {
    "label": "balance",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_net_repay",
   "values": {
    "name": "19. - VAT to repay",
    "code": "NE_REPAY",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_net_repay_balance",
   "values": {
    "label": "balance",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_net_to_pay",
   "values": {
    "name": "20. Net VAT to pay (8+19-17-18)",
    "code": "NE_TO_PAY",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_net_to_pay_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "subformula": "if_above(XOF(0))",
    "formula": "NE_GROSS_VAT.balance + NE_REPAY.balance - NE_DEDUCTIBLE_TOTAL.balance - NE_DEDUCTIBLE_ADDITION.balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_credit_to_report",
   "values": {
    "name": "21. Credit VAT to report (17+18-8-19)",
    "code": "NE_CREDIT_TO_REPORT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_credit_to_report_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "subformula": "if_above(XOF(0))",
    "formula": "NE_DEDUCTIBLE_TOTAL.balance + NE_DEDUCTIBLE_ADDITION.balance - NE_GROSS_VAT.balance - NE_REPAY.balance",
    "carryover_target": false
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_credit_to_report_carryover",
   "values": {
    "label": "_carryover_balance",
    "engine": "aggregation",
    "formula": "NE_CREDIT_TO_REPORT.balance",
    "carryover_target": "NE_REPORTED._applied_carryover_balance"
   }
  },
