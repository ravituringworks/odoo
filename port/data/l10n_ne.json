    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_deductible_local_invest_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "NE_11"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_deductible_imported_goods_services",
   "values": {
    "name": "12. VAT on imported goods and services",
    "code": "NE_IMPORT_GOODS_SERVICES",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_deductible_imported_goods_services_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "NE_12"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_deductible_local_goods_services",
   "values": {
    "name": "13. VAT on local goods and services",
    "code": "NE_LOCAL_GOODS_SERVICES",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_deductible_local_goods_services_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "NE_13"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_deductible_withheld",
   "values": {
    "name": "14. VAT withheld by customers",
    "code": "NE_WITHHELD",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_deductible_withheld_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "NE_14"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_deductible_reported",
   "values": {
