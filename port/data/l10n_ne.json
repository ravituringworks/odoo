    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_sales_self_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "NE_3"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_sales_imposable",
   "values": {
    "name": "4. Taxable turnover (1+2+3)",
    "code": "NE_TAXABLE",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ne_sales_imposable_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "NE_GOODS.balance + NE_SERVICE.balance + NE_SELF.balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ne_sales_export",
   "values": {
