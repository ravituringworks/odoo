   "model": "account.report.line",
   "id": "account_tax_report_line_tg_sales_taxable_export",
   "values": {
    "name": "10. Exports",
    "code": "TG_TAXABLE_EXPORT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_sales_taxable_taxable_export_base_tag",
   "values": {
    "label": "base",
