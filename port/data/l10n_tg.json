    "engine": "tax_tags",
    "formula": "TG_19_base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_assets_tax_tag",
   "values": {
    "label": "tax",
    "engine": "tax_tags",
    "formula": "TG_19"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_tg_deductible_complement",
   "values": {
    "name": "20. Additional reduction asked",
    "code": "TG_ADD_RED",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_complement_tax_tag",
   "values": {
    "label": "tax",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_tg_deductible_reimbursement",
   "values": {
    "name": "21. Reimbursement",
    "code": "TG_REIMBURSEMENT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_reimbursement_tax_tag",
   "values": {
    "label": "tax",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_tg_net_vat",
   "values": {
    "name": "23. Net VAT",
    "code": "TG_NET_VAT",
    "hierarchy_level": "0",
    "expression_ids": {
     "$unevaluated": "xml"
    },
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_net_vat_tax_tag",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "TG_SALES.tax - TG_VAT_DEDUCT.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_tg_to_pay",
   "values": {
    "name": "26. Net vat to pay",
    "code": "TG_TO_PAY",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_to_pay_tax_tag",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "TG_SALES.tax - TG_VAT_DEDUCT.tax",
    "subformula": "if_above(XOF(0))"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_tg_to_report",
   "values": {
    "name": "27. Credit to report",
    "code": "TG_REPORT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_to_report_tax_tag",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "TG_VAT_DEDUCT.tax - TG_SALES.tax",
    "subformula": "if_above(XOF(0))",
    "carryover_target": false
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_to_report_tax_carryover",
   "values": {
    "label": "_carryover_tax",
    "engine": "aggregation",
    "formula": "TG_REPORT.tax",
    "carryover_target": "TG_VAT_REPORTED._applied_carryover_tax"
   }
  },
