    "formula": "TG_10"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_tg_deductible",
   "values": {
    "name": "16. Deductible VAT",
    "code": "TG_VAT_DEDUCT",
    "hierarchy_level": "0",
    "expression_ids": {
     "$unevaluated": "xml"
    },
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_deductible_base_tag",
   "values": {
    "label": "base",
    "engine": "aggregation",
    "formula": "TG_GOODS_SERVICE.base + TG_Assets.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_deductible_tax_tag",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "TG_VAT_REPORTED.tax + TG_GOODS_SERVICE.tax + TG_Assets.tax - TG_ADD_RED.tax + TG_REIMBURSEMENT.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_tg_deductible_reported",
   "values": {
    "name": "17. VAT Reported",
    "code": "TG_VAT_REPORTED",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_deductible_reported_tax_tag",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "TG_VAT_REPORTED._applied_carryover_tax"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_deductible_reported_tax_tag_carryover",
   "values": {
    "label": "_applied_carryover_tax",
    "engine": "external",
    "formula": "most_recent",
    "date_scope": "previous_tax_period"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_tg_deductible_goods_services",
   "values": {
