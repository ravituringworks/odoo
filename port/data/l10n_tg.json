    "label": "base",
    "engine": "tax_tags",
    "formula": "TG_18_Base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_tg_goods_services_tax_tag",
   "values": {
    "label": "tax",
    "engine": "tax_tags",
    "formula": "TG_18"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_tg_deductible_assets",
