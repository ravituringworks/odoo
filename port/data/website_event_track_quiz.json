    }
   }
  },
  {
   "model": "event.quiz.question",
   "id": "event_7_track_1_question_0",
   "values": {
    "name": "What will we talk about during this event?",
    "sequence": "1",
    "quiz_id": {
     "$ref": "website_event_track_quiz.event_7_track_1_quiz"
    }
   }
  },
  {
   "model": "event.quiz.answer",
   "id": "event_7_track_1_question_0_0",
   "values": {
    "text_value": "Wood",
    "sequence": "1",
    "awarded_points": "1",
    "is_correct": true,
    "comment": "You're really smart!",
    "question_id": {
     "$ref": "event_7_track_1_question_0"
    }
   }
  },
  {
   "model": "event.quiz.answer",
   "id": "event_7_track_1_question_0_1",
   "values": {
    "text_value": "Music",
    "sequence": "2",
    "comment": "Even if there will be some.",
    "question_id": {
     "$ref": "event_7_track_1_question_0"
    }
   }
  },
  {
   "model": "event.quiz.answer",
   "id": "event_7_track_1_question_0_2",
   "values": {
    "text_value": "Open Source Apps",
    "sequence": "3",
    "comment": "OpenWood is not an Open Source congres about Apps.",
    "question_id": {
     "$ref": "event_7_track_1_question_0"
    }
   }
  },
  {
   "model": "event.quiz.question",
   "id": "event_7_track_1_question_1",
   "values": {
    "name": "Where does lumber comes from?",
    "sequence": "2",
    "quiz_id": {
     "$ref": "website_event_track_quiz.event_7_track_1_quiz"
    }
   }
  },
  {
   "model": "event.quiz.answer",
   "id": "event_7_track_1_question_1_0",
   "values": {
    "text_value": "Trees!",
    "sequence": "1",
    "awarded_points": "1",
    "is_correct": true,
    "question_id": {
     "$ref": "event_7_track_1_question_1"
    }
   }
  },
  {
   "model": "event.quiz.answer",
   "id": "event_7_track_1_question_1_1",
   "values": {
    "text_value": "Stores!",
    "sequence": "2",
    "comment": "Lumbers need first to be cut from trees!",
    "question_id": {
     "$ref": "event_7_track_1_question_1"
    }
   }
  },
  {
   "model": "event.quiz",
   "id": "event_7_track_5_quiz",
   "values": {
    "name": "Securing your Lumber during transport",
    "event_track_id": {
     "$ref": "website_event_track.event_7_track_5"
    }
   }
  },
  {
   "model": "event.quiz.question",
   "id": "event_7_track_5_question_0",
   "values": {
    "name": "Transporting lumber from stores to your house is safe.",
    "sequence": "1",
    "quiz_id": {
     "$ref": "website_event_track_quiz.event_7_track_5_quiz"
    }
   }
  },
  {
   "model": "event.quiz.answer",
   "id": "event_7_track_5_question_0_0",
   "values": {
    "text_value": "Yes",
    "sequence": "1",
    "comment": "In order to avoid accident, you need to secure any product of this kind during transportation!",
    "question_id": {
     "$ref": "event_7_track_5_question_0"
    }
   }
  },
  {
   "model": "event.quiz.answer",
   "id": "event_7_track_5_question_0_1",
   "values": {
    "text_value": "No",
    "sequence": "2",
    "awarded_points": "1",
    "is_correct": true,
    "comment": "Even if you have a big trunk, some long products need to be secured.",
    "question_id": {
     "$ref": "event_7_track_5_question_0"
    }
   }
  },
  {
   "model": "event.quiz.question",
   "id": "event_7_track_5_question_1",
   "values": {
    "name": "What kind of tool are needed to secure your lumber?",
    "sequence": "2",
    "quiz_id": {
     "$ref": "website_event_track_quiz.event_7_track_5_quiz"
    }
   }
  },
  {
   "model": "event.quiz.answer",
   "id": "event_7_track_5_question_1_0",
   "values": {
    "text_value": "Hammer",
    "sequence": "1",
    "comment": "Hammer won't be of any help here!",
    "question_id": {
     "$ref": "event_7_track_5_question_1"
    }
   }
  },
  {
   "model": "event.quiz.answer",
   "id": "event_7_track_5_question_1_1",
   "values": {
    "text_value": "Tie-down straps and other wooden blocks",
    "sequence": "2",
    "awarded_points": "1",
    "is_correct": true,
    "question_id": {
     "$ref": "event_7_track_5_question_1"
    }
   }
  },
  {
   "model": "event.quiz.answer",
   "id": "event_7_track_5_question_1_2",
   "values": {
    "text_value": "Scotch tape",
    "sequence": "3",
    "comment": "Well, it could work but you will need a lot of tape!",
    "question_id": {
     "$ref": "event_7_track_5_question_1"
    }
   }
  },
