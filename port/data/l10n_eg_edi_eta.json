    "name": "Only see/modify own thumb drive",
    "model_id": {
     "$ref": "l10n_eg_edi_eta.model_l10n_eg_edi_thumb_drive"
    },
    "domain_force": "[('user_id', '=', user.id)]"
   }
  },
  {
   "model": "ir.actions.server",
   "id": "action_sign_invoices",
   "values": {
    "name": "Sign invoices",
    "state": "code",
    "model_id": {
     "$ref": "account.model_account_move"
    },
    "binding_model_id": {
     "$ref": "account.model_account_move"
    },
    "code": "action = records.action_post_sign_invoices()"
   }
  },
  {
