   "values": {
    "label": "tax",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable;rounding=2"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_line_input_vat_attributable_to_taxable_and_exempt_supplies",
