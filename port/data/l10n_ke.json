  },
  {
   "model": "account.report.line",
   "id": "tax_report_line_other_rate_purchases",
   "values": {
    "name": "8. Taxable Purchases (Other Rate 8%)",
    "code": "box_8",
    "expression_ids": {
     "$unevaluated": "xml"
    }
