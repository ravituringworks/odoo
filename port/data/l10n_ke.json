   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "box_12.tax + box_13.tax - box_14.tax - box_16.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_line_vat_payable_or_credit_due_for_period",
   "values": {
