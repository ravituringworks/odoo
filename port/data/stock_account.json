   "group": "account.group_account_readonly",
   "read": true,
   "write": false,
   "create": false,
   "unlink": false
  },
  {
   "id": "access_stock_move_invoicing_payments",
   "model": "stock.move",
   "model_xmlid": "model_stock_move",
   "group": "account.group_account_invoice",
   "read": true,
   "write": true,
   "create": true,
   "unlink": false
  },
  {
   "id": "access_stock_valuation_layer",
   "model": "stock.valuation.layer",
   "model_xmlid": "model_stock_valuation_layer",
   "group": "stock.group_stock_manager",
   "read": true,
   "write": true,
   "create": true,
   "unlink": false
  },
  {
   "id": "access_stock_valuation_layer_revaluation",
   "model": "stock.valuation.layer.revaluation",
   "model_xmlid": "model_stock_valuation_layer_revaluation",
   "group": "stock.group_stock_manager",
   "read": true,
   "write": true,
   "create": true,
   "unlink": false
  }
 ]
}