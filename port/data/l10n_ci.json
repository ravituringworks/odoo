     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ci_to_report_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "CI_VAT_DEDUCT.tax - CI_GROSS.tax - CI_REIMBURSEMENT.tax",
    "subformula": "if_above(XOF(0))",
    "carryover_target": false
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ci_to_report_carryover",
   "values": {
    "label": "_carryover_tax",
    "engine": "aggregation",
    "formula": "CI_REPORT.tax",
    "carryover_target": "CI_CREDIT_REPORTED._applied_carryover_tax"
   }
