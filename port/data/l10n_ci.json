    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ci_tva_credit_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "CI_CREDIT_REPORTED._applied_carryover_tax"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_ci_tva_credit_tax_carryover",
   "values": {
    "label": "_applied_carryover_tax",
    "engine": "external",
    "formula": "most_recent",
    "date_scope": "previous_tax_period"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ci_net_to_pay",
