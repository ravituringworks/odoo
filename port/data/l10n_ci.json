   "model": "account.report.expression",
   "id": "account_tax_report_line_ci_net_to_pay_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "CI_GROSS.tax - CI_VAT_DEDUCT.tax",
    "subformula": "if_above(XOF(0))"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_ci_asked_reimbursement",
   "values": {
    "name": "Credit asked to be reimbursed",
    "code": "CI_REIMBURSEMENT",
    "expression_ids": {
