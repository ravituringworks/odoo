{
 "module": "website_crm",
 "records": [
  {
   "model": "ir.actions.act_url",
   "id": "action_open_website",
   "values": {
    "name": "Website Contact Form",
    "target": "self",
    "url": "/contactus"
   }
  },
  {
   "model": "ir.actions.todo",
   "id": "base.open_menu",
   "values": {
    "action_id": {
     "$ref": "action_open_website"
    },
    "state": "open"
   }
  },
  {
   "model": "ir.model",
   "id": "crm.model_crm_lead",
   "values": {
    "website_form_key": "create_lead",
    "website_form_default_field_id": {
     "$ref": "crm.field_crm_lead__description"
    },
    "website_form_access": "True",
    "website_form_label": "Create an Opportunity"
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "crm_lead_action_from_visitor",
   "values": {
    "name": "Leads",
    "res_model": "crm.lead",
    "view_mode": "list,form",
    "domain": {
     "$unevaluated": "[('visitor_ids', 'in', [active_id])]"
    },
    "help": {
     "$unevaluated": "xml"
    }
   }
  }
 ],
 "menus": [],
 "access": [
  {
   "id": "access_website_visitor_salesman",
   "model": "website.visitor",
   "model_xmlid": "model_website_visitor",
   "group": "sales_team.group_sale_salesman",
   "read": true,
   "write": false,
   "create": false,
   "unlink": false
  },
  {
   "id": "access_website_track_salesman",
   "model": "website.website.track",
   "model_xmlid": "website.model_website_track",
   "group": "sales_team.group_sale_salesman",
   "read": true,
   "write": false,
   "create": false,
   "unlink": false
  }
 ]
}