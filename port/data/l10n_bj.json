{
 "module": "l10n_bj",
 "records": [
  {
   "model": "account.report",
   "id": "account_tax_report_bj",
   "values": {
    "name": "VAT Report",
    "root_report_id": {
     "$ref": "account.generic_tax_report"
    },
    "country_id": {
     "$ref": "base.bj"
    },
    "filter_fiscal_position": true,
    "availability_condition": "country",
    "column_ids": {
     "$unevaluated": "xml"
    },
    "line_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.column",
   "id": "account_tax_report_bj_balance",
   "values": {
    "name": "Balance",
    "expression_label": "balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_turnover",
   "values": {
    "name": "II. Turnover (Without Tax)",
    "code": "BJ_TURNOVER",
    "hierarchy_level": "0",
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_sales_exempt",
   "values": {
    "name": "1. Exempted turnover",
    "code": "BJ_EXEMPT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_sales_exempt_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BJ_1"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_sales_export",
   "values": {
    "name": "2. Export of taxable products",
    "code": "BJ_EXPORT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_sales_export_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BJ_2"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_sales_export_non_taxable",
   "values": {
    "name": "3. Export of non-taxable products",
    "code": "BJ_EXPORT_NON_TAXABLE",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_sales_export_non_taxable_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BJ_3"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_sales_taxable",
   "values": {
    "name": "4. Taxable operations",
    "code": "BJ_TAXABLE",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_sales_taxable_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BJ_4"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_sales_self",
   "values": {
    "name": "5. Self Deliveries",
    "code": "BJ_SELF",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_sales_self_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BJ_5"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_sales_total_turnover",
   "values": {
    "name": "6. Total turnover without VAT",
    "code": "BJ_TOTAL_TURNOVER",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_sales_total_turnover_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "BJ_EXEMPT.balance + BJ_EXPORT.balance + BJ_EXPORT_NON_TAXABLE.balance + BJ_TAXABLE.balance + BJ_SELF.balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_deductions",
   "values": {
    "name": "III. Deductions",
    "code": "BJ_DEDUCTIONS",
    "hierarchy_level": "0",
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_deductible_reported",
   "values": {
    "name": "7. Credit reported from last month",
    "code": "BJ_REPORTED",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_deductible_reported_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "BJ_REPORTED._applied_carryover_balance"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_deductible_reported_balance_carryover",
   "values": {
    "label": "_applied_carryover_balance",
    "engine": "external",
    "formula": "most_recent",
    "date_scope": "previous_tax_period"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_deductible_goods_services",
   "values": {
    "name": "8. Deduction on goods and services (without assets)",
    "code": "BJ_GOODS_SERVICES",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_deductible_goods_services_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BJ_8"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_deductible_assets",
   "values": {
    "name": "9. Deduction on assets",
    "code": "BJ_ASSETS",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_deductible_assets_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BJ_9"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_deductible_additional",
   "values": {
    "name": "10. Additional deductions",
    "code": "BJ_DEDU_ADDITIONAL",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_deductible_additional_balance",
   "values": {
    "label": "balance",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_deductible_repayment",
   "values": {
    "name": "11. Repayment to do",
    "code": "BJ_DEDU_REPAYMENT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_deductible_repayment_balance",
   "values": {
    "label": "balance",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_deductible_total",
   "values": {
    "name": "12. Total",
    "code": "BJ_DEDU_TOTAL",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_deductible_total_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "BJ_REPORTED.balance + BJ_GOODS_SERVICES.balance + BJ_ASSETS.balance + BJ_DEDU_ADDITIONAL.balance + BJ_DEDU_REPAYMENT.balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_net",
   "values": {
    "name": "IV. NET VAT",
    "code": "BJ_NET",
    "hierarchy_level": "0",
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_net_gross",
   "values": {
    "name": "13. Gross VAT (18% x l.4 + l.5)",
    "code": "BJ_GROSS",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_net_gross_balance",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BJ_13"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_net_deductible",
   "values": {
    "name": "14. VAT deductible",
    "code": "BJ_VAT_DEDUCTIBLE",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_net_deductible_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "BJ_DEDU_TOTAL.balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_net_to_pay",
   "values": {
    "name": "15. Net VAT to pay",
    "code": "BJ_NET_TO_PAY",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_net_to_pay_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "BJ_GROSS.balance - BJ_VAT_DEDUCTIBLE.balance",
    "subformula": "if_above(XOF(0))"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_bj_credit_to_report",
   "values": {
    "name": "16. Credit to report",
    "code": "BJ_TO_REPORT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_credit_to_report_balance",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "BJ_VAT_DEDUCTIBLE.balance - BJ_GROSS.balance",
    "subformula": "if_above(XOF(0))",
    "carryover_target": false
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_bj_credit_to_report_carryover",
   "values": {
    "label": "_carryover_balance",
    "engine": "aggregation",
    "formula": "BJ_TO_REPORT.balance",
    "carryover_target": "BJ_REPORTED._applied_carryover_balance"
   }
  },
  {
