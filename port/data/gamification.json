  {
   "model": "gamification.goal.definition",
   "id": "definition_base_timezone",
   "values": {
    "name": "Set your Timezone",
    "description": "Configure your profile and specify your timezone",
    "computation_mode": "count",
    "display_mode": "boolean",
    "model_id": {
     "$ref": "base.model_res_users"
    },
    "domain": [
     [
      "partner_id.tz",
      "!=",
      false
     ]
    ],
    "action_id": {
     "$ref": "base.action_res_users_my"
    },
    "res_id_field": "user.id",
    "batch_mode": "True",
    "batch_distinctive_field": {
     "$ref": "base.field_res_users__id"
    },
    "batch_user_expression": "user.id"
   }
  },
  {
   "model": "gamification.goal.definition",
   "id": "definition_base_company_data",
   "values": {
    "name": "Set your Company Data",
    "description": "Write some information about your company (specify at least a name)",
    "computation_mode": "count",
    "display_mode": "boolean",
    "model_id": {
     "$ref": "base.model_res_company"
    },
    "domain": {
     "$unevaluated": "[('user_ids', 'in', [user.id]), ('name', '=', 'YourCompany')]"
    },
    "condition": "lower",
    "action_id": {
     "$ref": "base.action_res_company_form"
    },
    "res_id_field": "user.company_id.id"
   }
  },
