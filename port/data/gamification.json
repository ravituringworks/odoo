  {
   "model": "ir.rule",
   "id": "goal_user_visibility",
   "values": {
    "name": "User can only see his/her goals or goal from the same challenge in board visibility",
    "model_id": {
     "$ref": "model_gamification_goal"
    },
    "groups": [
     [
      4,
      {
       "$ref": "base.group_user"
      }
     ],
     [
      4,
      {
       "$ref": "base.group_portal"
      }
     ]
    ],
    "perm_read": true,
    "perm_write": true,
    "perm_create": false,
    "perm_unlink": false,
    "domain_force": "[\n                '|',\n                    ('user_id','=',user.id),\n                    '&',\n                        ('challenge_id.user_ids','in',user.id),\n                        ('challenge_id.visibility_mode','=','ranking')]"
   }
  },
  {
   "model": "ir.rule",
   "id": "goal_gamification_manager_visibility",
   "values": {
    "name": "Manager can see any goal",
    "model_id": {
     "$ref": "model_gamification_goal"
    },
    "groups": [
     [
      4,
      {
       "$ref": "base.group_erp_manager"
      }
     ]
    ],
    "perm_read": true,
    "perm_write": true,
    "perm_create": false,
    "perm_unlink": false,
    "domain_force": "[(1, '=', 1)]"
   }
  },
  {
   "model": "ir.rule",
   "id": "goal_global_multicompany",
   "values": {
    "name": "Multicompany rule on challenges",
    "model_id": {
     "$ref": "model_gamification_goal"
    },
    "domain_force": "[('user_id.company_id', 'in', company_ids)]"
   }
  },
