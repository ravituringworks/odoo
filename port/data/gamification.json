{
 "module": "gamification",
 "records": [
  {
   "model": "ir.actions.act_window",
   "id": "action_grant_wizard",
   "values": {
    "name": "Grant Badge",
    "res_model": "gamification.badge.user.wizard",
    "view_id": {
     "$ref": "gamification.view_badge_wizard_grant"
    },
    "target": "new",
    "context": {
     "$unevaluated": "{\n            'default_badge_id': active_id,\n            'badge_id': active_id\n        }"
    }
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "action_current_rank_users",
   "values": {
    "name": "Users",
    "res_model": "res.users",
    "view_mode": "list,form",
    "domain": {
     "$unevaluated": "[('rank_id', '=', active_id)]"
    }
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "action_new_simplified_res_users",
   "values": {
    "name": "Create User",
    "res_model": "res.users",
    "target": "current",
    "view_id": {
     "$ref": "base.view_users_simple_form"
    },
    "context": {},
    "help": "Create and manage users that will connect to the system. Users can be deactivated should there be a period of time during which they will/should not connect to the system. You can assign them groups in order to give them specific access to the applications they need to use in the system."
   }
  },
  {
   "model": "ir.actions.act_window",
   "id": "gamification_karma_ranks_action",
