{
 "module": "web",
 "records": [
  {
   "model": "ir.actions.act_window",
   "id": "action_base_document_layout_configurator",
   "values": {
    "name": "Configure your document layout",
    "view_mode": "form",
    "target": "new",
    "res_model": "base.document.layout",
    "view_id": {
     "$ref": "web.view_base_document_layout"
    },
    "context": {
     "dialog_size": "extra-large"
    }
   }
  },
  {
   "model": "ir.actions.server",
   "id": "download_contact",
   "values": {
    "name": "Download (vCard)",
    "model_id": {
     "$ref": "model_res_partner"
    },
    "binding_model_id": {
     "$ref": "model_res_partner"
    },
    "binding_view_types": "form,list",
    "state": "code",
    "code": "action = {\n                'type': 'ir.actions.act_url',\n                'url': '/web/partner/vcard?partner_ids=' + ','.join(map(str, records.ids)),\n                'target': 'download',\n            }"
   }
  },
  {
   "model": "ir.attachment",
   "id": "image_placeholder",
   "values": {
    "name": "placeholder.png",
    "type": "url",
    "url": "/web/static/img/placeholder.png",
    "public": "True"
   }
  },
  {
   "model": "report.layout",
   "id": "report_layout_striped",
   "values": {
    "name": "Striped",
    "sequence": "5",
    "view_id": {
     "$ref": "web.external_layout_striped"
    }
   }
  },
  {
   "model": "report.layout",
   "id": "report_layout_standard",
   "values": {
    "name": "Light",
    "sequence": "2",
    "view_id": {
     "$ref": "web.external_layout_standard"
    }
   }
  },
  {
   "model": "report.layout",
   "id": "report_layout_boxed",
   "values": {
    "name": "Boxed",
    "sequence": "3",
    "view_id": {
     "$ref": "web.external_layout_boxed"
    }
   }
  },
  {
   "model": "report.layout",
   "id": "report_layout_bold",
   "values": {
    "name": "Bold",
    "sequence": "4",
    "view_id": {
     "$ref": "web.external_layout_bold"
    }
   }
  },
  {
   "model": "report.layout",
   "id": "report_layout_bubble",
   "values": {
    "name": "Bubble",
    "sequence": "6",
    "view_id": {
     "$ref": "web.external_layout_bubble"
    }
   }
  },
  {
   "model": "report.layout",
   "id": "report_layout_wave",
   "values": {
    "name": "Wave",
    "sequence": "7",
    "view_id": {
     "$ref": "web.external_layout_wave"
    }
   }
  },
  {
   "model": "report.layout",
   "id": "report_layout_folder",
   "values": {
    "name": "Folder",
    "sequence": "8",
    "view_id": {
     "$ref": "web.external_layout_folder"
    }
   }
  },
  {
   "model": "ir.attachment",
   "id": "asset_styles_company_report",
   "values": {
    "datas": {
     "$unevaluated": "obj()._get_asset_style_b64()"
    },
    "mimetype": "text/scss",
    "name": "res.company.scss",
    "type": "binary",
    "url": "web/static/asset_styles_company_report.scss"
   }
  }
 ],
 "menus": [],
 "access": [
  {
   "id": "access_base_document_layout",
   "model": "base.document.layout",
   "model_xmlid": "model_base_document_layout",
   "group": "base.group_system",
   "read": true,
   "write": true,
   "create": true,
   "unlink": false
  }
 ]
}