   "values": {
    "label": "vat_due",
    "engine": "aggregation",
    "formula": "l10n_tn_sale_7.vat_due +\n                                                      l10n_tn_sale_13.vat_due +\n                                                      l10n_tn_sale_19.vat_due +\n                                                      l10n_tn_sale_6.vat_due +\n                                                      l10n_tn_sale_12.vat_due +\n                                                      l10n_tn_sale_18.vat_due +\n                                                      l10n_tn_vat_repayment.vat_due"
   }
  },
  {
