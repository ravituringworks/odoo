{
 "module": "l10n_nz",
 "records": [
  {
   "model": "account.report",
   "id": "tax_report",
   "values": {
    "name": "GST Report",
    "root_report_id": {
     "$ref": "account.generic_tax_report"
    },
    "country_id": {
     "$ref": "base.nz"
    },
    "filter_fiscal_position": true,
    "availability_condition": "country",
    "column_ids": {
     "$unevaluated": "xml"
    },
    "line_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.column",
   "id": "tax_report_balance",
   "values": {
    "name": "Balance",
    "expression_label": "balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_sale_and_income",
   "values": {
    "name": "Sales and Income",
    "aggregation_formula": "NZBOX5.balance + NZBOX9.balance",
    "hierarchy_level": "0",
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box5",
   "values": {
    "name": "[BOX 5] Total sales and income for the period(including GST and zero-rated Supplies)",
    "code": "NZBOX5",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_box5_tag",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BOX 5"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box6",
   "values": {
    "name": "[BOX 6] Zero-rated supplies in Box 5",
    "code": "NZBOX6",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_box6_tag",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BOX 6"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box7",
   "values": {
    "name": "[BOX 7] The amount in Box 6 is subracted from Box 5",
    "code": "NZBOX7",
    "aggregation_formula": "NZBOX5.balance - NZBOX6.balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box8",
   "values": {
    "name": "[BOX 8] Multiply the amount in Box 7 by 3 and then divide by 23",
    "code": "NZBOX8",
    "aggregation_formula": "(NZBOX7.balance * 3)/23"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box9",
   "values": {
    "name": "[BOX 9] Enter any adjustments from your calculation sheet",
    "code": "NZBOX9",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_box9_tag",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BOX 9"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box10",
   "values": {
    "name": "[BOX 10] Total GST collected on sales and income",
    "code": "NZBOX10",
    "aggregation_formula": "NZBOX8.balance + NZBOX9.balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_purchases_and_expenses",
   "values": {
    "name": "Purchases and Expenses",
    "aggregation_formula": "NZBOX11.balance + NZBOX13.balance",
    "hierarchy_level": "0",
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box11",
   "values": {
    "name": "[BOX 11] Total purchases and expenses(including GST) for which tax invoicing requirements have been met",
    "code": "NZBOX11",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_box11_tag",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BOX 11"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box12",
   "values": {
    "name": "[BOX 12] Multiply BOX11 by 3 and then divide by 23",
    "code": "NZBOX12",
    "aggregation_formula": "(NZBOX11.balance * 3)/23"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box13",
   "values": {
    "name": "[BOX 13] Credit adjustments from your calculation sheet",
    "code": "NZBOX13",
    "expression_ids": {
     "$unevaluated": "xml"
    },
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_box13_aggregation",
   "values": {
    "label": "balance",
    "engine": "aggregation",
    "formula": "NZBOX13_tags.balance + NZBOX13_manual.balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box13_tags",
   "values": {
    "name": "[BOX 13] Amount computed from tax tags",
    "code": "NZBOX13_tags",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_box13_tag",
   "values": {
    "label": "balance",
    "engine": "tax_tags",
    "formula": "BOX 13"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box13_manual",
   "values": {
    "name": "[BOX 13] Manual adjustments",
    "code": "NZBOX13_manual",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "tax_report_box13_formula",
   "values": {
    "label": "balance",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable;rounding=2"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box14",
   "values": {
    "name": "[BOX 14] Total GST credit for purchases and expenses",
    "code": "NZBOX14",
    "aggregation_formula": "NZBOX12.balance + NZBOX13.balance"
   }
  },
  {
   "model": "account.report.line",
   "id": "tax_report_box15",
   "values": {
    "name": "[BOX 15] Difference between BOX10 and BOX14",
    "aggregation_formula": "NZBOX10.balance - NZBOX14.balance",
    "hierarchy_level": "0"
   }
  },
