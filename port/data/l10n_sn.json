{
 "module": "l10n_sn",
 "records": [
  {
   "model": "account.report",
   "id": "account_tax_report_sn",
   "values": {
    "name": "VAT Report",
    "root_report_id": {
     "$ref": "account.generic_tax_report"
    },
    "country_id": {
     "$ref": "base.sn"
    },
    "filter_fiscal_position": true,
    "availability_condition": "country",
    "column_ids": {
     "$unevaluated": "xml"
    },
    "line_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.column",
   "id": "account_tax_report_sn_base",
   "values": {
    "name": "Base",
    "expression_label": "base"
   }
  },
  {
   "model": "account.report.column",
   "id": "account_tax_report_sn_tax",
   "values": {
    "name": "Tax",
    "expression_label": "tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_operations",
   "values": {
    "name": "Total amount of operations",
    "code": "SN_OPE",
    "expression_ids": {
     "$unevaluated": "xml"
    },
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_operations_base",
   "values": {
    "label": "base",
    "engine": "aggregation",
    "formula": "SN_Export.base + SN_NON_TAXED.base + SN_SUSPENSION.base + SN_EXEMPT.base + SN_SELF.base + SN_TAXABLE.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_operations_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "SN_TAXABLE.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_exportation",
   "values": {
    "name": "Exportations",
    "code": "SN_Export",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_exportation_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "export"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_non_taxed",
   "values": {
    "name": "Non Taxed Domestic Operation",
    "code": "SN_NON_TAXED",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_non_taxed_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "non_taxed"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_suspension",
   "values": {
    "name": "Operation done under suspension of VAT",
    "code": "SN_SUSPENSION",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_suspension_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "suspension"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_exempt",
   "values": {
    "name": "Operations exempted",
    "code": "SN_EXEMPT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_exempt_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "sale_exempt"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_self_delivery",
   "values": {
    "name": "Self delivery or service",
    "code": "SN_SELF",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_self_delivery_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "sale_self"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_taxable",
   "values": {
    "name": "Taxable operations",
    "code": "SN_TAXABLE",
    "expression_ids": {
     "$unevaluated": "xml"
    },
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_taxable_base",
   "values": {
    "label": "base",
    "engine": "aggregation",
    "formula": "SN_TAXABLE_18.base + SN_TAXABLE_10.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_taxable_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "SN_TAXABLE_18.tax + SN_TAXABLE_10.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_taxable_18",
   "values": {
    "name": "Taxable - normal rate",
    "code": "SN_TAXABLE_18",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_taxable_18_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "base_sale_18"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_taxable_18_tax",
   "values": {
    "label": "tax",
    "engine": "tax_tags",
    "formula": "tax_sale_18"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_taxable_10",
   "values": {
    "name": "Taxable - reduced rate",
    "code": "SN_TAXABLE_10",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_taxable_10_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "base_sale_10"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_taxable_10_tax",
   "values": {
    "label": "tax",
    "engine": "tax_tags",
    "formula": "tax_sale_10"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_deductible",
   "values": {
    "name": "Deductible",
    "code": "SN_VAT_DEDUCT",
    "expression_ids": {
     "$unevaluated": "xml"
    },
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_deductible_base",
   "values": {
    "label": "base",
    "engine": "aggregation",
    "formula": "SN_PREPAY.base + SN_IMPORT.base + SN_DOMESTIC.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_deductible_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "SN_PREPAY.tax + SN_IMPORT.tax + SN_DOMESTIC.tax + SN_REIMBURSEMENT_ACCEPTED.tax + SN_CREDIT.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_prepayment",
   "values": {
    "name": "Tax Prepayment",
    "code": "SN_PREPAY",
    "expression_ids": {
     "$unevaluated": "xml"
    },
    "children_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_prepayment_base",
   "values": {
    "label": "base",
    "engine": "aggregation",
    "formula": "SN_WITHHOLDING.base"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_prepayment_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "SN_WITHHOLDING.tax + SN_DDI.tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_withholding",
   "values": {
    "name": "Withholding",
    "code": "SN_WITHHOLDING",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_withholding_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "base_withholding"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_withholding_tax",
   "values": {
    "label": "tax",
    "engine": "tax_tags",
    "formula": "tax_withholding"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_ddi",
   "values": {
    "name": "DDI checks",
    "code": "SN_DDI",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_ddi_tax",
   "values": {
    "label": "tax",
    "engine": "tax_tags",
    "formula": "ddi"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_deductible_import",
   "values": {
    "name": "Importations",
    "code": "SN_IMPORT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_deductible_import_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "base_import"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_deductible_import_tax",
   "values": {
    "label": "tax",
    "engine": "tax_tags",
    "formula": "tax_import"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_deductible_taxable",
   "values": {
    "name": "Domestic purchases",
    "code": "SN_DOMESTIC",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_deductible_taxable_base",
   "values": {
    "label": "base",
    "engine": "tax_tags",
    "formula": "base_purchase"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_deductible_taxable_tax",
   "values": {
    "label": "tax",
    "engine": "tax_tags",
    "formula": "tax_purchase"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_reimbursement_accepted",
   "values": {
    "name": "Reimbursements accepted",
    "code": "SN_REIMBURSEMENT_ACCEPTED",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_reimbursement_accepted_tax",
   "values": {
    "label": "tax",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_tva_credit",
   "values": {
    "name": "Last month's credit",
    "code": "SN_CREDIT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_tva_credit_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "SN_CREDIT._applied_carryover_tax"
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_tva_credit_tax_carryover",
   "values": {
    "label": "_applied_carryover_tax",
    "engine": "external",
    "formula": "most_recent",
    "date_scope": "previous_tax_period"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_due",
   "values": {
    "name": "Balance due",
    "code": "SN_DUE",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_due_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "SN_OPE.tax - SN_VAT_DEDUCT.tax",
    "subformula": "if_above(XOF(0))"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_to_report",
   "values": {
    "name": "Credit to report",
    "code": "SN_REPORT",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_to_report_tax",
   "values": {
    "label": "tax",
    "engine": "aggregation",
    "formula": "SN_VAT_DEDUCT.tax - SN_OPE.tax",
    "subformula": "if_above(XOF(0))",
    "carryover_target": false
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_to_report_carryover",
   "values": {
    "label": "_carryover_tax",
    "engine": "aggregation",
    "formula": "SN_REPORT.tax",
    "carryover_target": "SN_CREDIT._applied_carryover_tax"
   }
  },
  {
   "model": "account.report.line",
   "id": "account_tax_report_line_sn_reimbursement_review",
   "values": {
    "name": "Reimbursement under review",
    "code": "SN_REIMBURSEMENT_REVIEW",
    "expression_ids": {
     "$unevaluated": "xml"
    }
   }
  },
  {
   "model": "account.report.expression",
   "id": "account_tax_report_line_sn_reimbursement_review_tax",
   "values": {
    "label": "tax",
    "engine": "external",
    "formula": "sum",
    "subformula": "editable"
   }
  },
